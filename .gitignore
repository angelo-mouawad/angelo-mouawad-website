# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values stay local, the example is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tool config (the MCP file holds an API key)
.mcp.json
.claude/

# editors and operating systems
.idea/
.vscode/
Thumbs.db

# screenshots and reports from Playwright checks
/test-results/
/playwright-report/

# reference components kept locally, not part of the build
/imported_components/

# raw downloaded assets
/.asset-cache/

# copied from the notes folder on every dev and build
/public/notes-assets/

# the notes come from the separate notes repo: a junction to the vault locally, a checkout in CI
/content/notes
